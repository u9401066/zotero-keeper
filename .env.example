# =============================================================================
# Zotero Keeper - Environment Configuration
# =============================================================================
# Copy this file to .env and modify according to your setup.
# 將此檔案複製為 .env 並根據你的環境修改設定。

# -----------------------------------------------------------------------------
# Zotero Connection Settings | Zotero 連線設定
# -----------------------------------------------------------------------------

# Zotero Desktop Local API loopback host. Keep this on localhost/127.0.0.1.
# Never expose or forward Zotero's unauthenticated port 23119 to a network.
# Zotero Desktop Local API 的 loopback 主機。請保持 localhost/127.0.0.1，
# 不要將未驗證的 23119 port 暴露或轉送至網路。
ZOTERO_HOST=localhost

# Zotero HTTP server port (default: 23119)
# This is Zotero's built-in port, usually no need to change
# 這是 Zotero 內建的 port，通常不需要修改
ZOTERO_PORT=23119

# Request timeout in seconds
# 請求超時時間（秒）
ZOTERO_TIMEOUT=30

# -----------------------------------------------------------------------------
# PubMed Integration (Optional) | PubMed 整合（選用）
# -----------------------------------------------------------------------------

# Your email for NCBI/PubMed API (recommended for higher rate limits)
# 你的 email，用於 NCBI/PubMed API（建議設定以獲得更高的請求限制）
NCBI_EMAIL=your.email@example.com

# NCBI API key (optional, for higher rate limits)
# Get from: https://www.ncbi.nlm.nih.gov/account/settings/
# NCBI API 金鑰（選用，可獲得更高的請求限制）
# NCBI_API_KEY=your_api_key_here

# Optional: re-enable legacy keeper PubMed bridge/import tools
# 可選：重新啟用 keeper 舊版 PubMed bridge / import 工具
# ZOTERO_KEEPER_ENABLE_LEGACY_PUBMED_TOOLS=1

# Optional: local development override for a checked-out pubmed-search-mcp source tree
# 可選：本地開發時指定 pubmed-search-mcp 原始碼目錄覆蓋已安裝套件
# PUBMED_SEARCH_PATH=../external/pubmed-search-mcp

# -----------------------------------------------------------------------------
# Network Security Notes | 網路安全說明
# -----------------------------------------------------------------------------
#
# Local Setup (Zotero on same machine):
#   ZOTERO_HOST=localhost
#   ZOTERO_PORT=23119
#
# For remote libraries, do not port-forward the Local/Connector API. Use
# Zotero's authenticated HTTPS Web API, or a purpose-built authenticated service
# with TLS, authorization, auditing, and explicit network access controls.
# 遠端資料庫請勿轉送 Local/Connector API；請改用 Zotero HTTPS Web API，
# 或具 TLS、授權、稽核與明確網路存取控制的專用服務。
#
# -----------------------------------------------------------------------------
